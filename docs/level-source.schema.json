{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Volcano level source version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "background",
    "objects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "format": {
      "const": "volcano-level-1"
    },
    "version": {
      "const": 301
    },
    "background": {
      "type": "string",
      "maxLength": 127
    },
    "max_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_cafe",
        "basin_goal",
        "food",
        "fuel",
        "money",
        "rescue_goal",
        "wood"
      ],
      "properties": {
        "_comment": {
          "type": "string"
        },
        "allow_cafe": {
          "type": "boolean"
        },
        "basin_goal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "food": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "fuel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "money": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "rescue_goal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "wood": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "points"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "layer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "_comment": {
                "type": "string"
              },
              "type": {
                "enum": [
                  18,
                  "traffic"
                ]
              },
              "points": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295,
                    "not": {
                      "const": 18
                    }
                  },
                  {
                    "enum": [
                      "scenery",
                      "marker",
                      "background",
                      "effect",
                      "ambient",
                      "unknown_marker",
                      "building",
                      "barrier",
                      "worker",
                      "animal",
                      "resource",
                      "civilian",
                      "base",
                      "helicopter",
                      "helipad",
                      "boat",
                      "pier",
                      "doctor",
                      "hospital",
                      "station",
                      "train",
                      "thief",
                      "road_entry",
                      "police",
                      "police_station",
                      "firefighter",
                      "fire_station",
                      "valve",
                      "scenario",
                      "medicine",
                      "campaign_node",
                      "campaign_bridge",
                      "bonfire",
                      "air_delivery",
                      "delivery_place",
                      "generator",
                      "lot",
                      "boost",
                      "campaign_tile",
                      "scenario_marker",
                      "runway_light",
                      "pollution",
                      "offroad_region",
                      "atv",
                      "garage"
                    ]
                  }
                ]
              },
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "layer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "_comment": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "maxLength": 511
              },
              "params": {
                "type": "string",
                "maxLength": 4095
              },
              "extra": {
                "type": "string",
                "maxLength": 4095
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "rotation": {
                "type": "number"
              },
              "scale_x": {
                "type": "number"
              },
              "scale_y": {
                "type": "number"
              },
              "link_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "auxiliary": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "not": {
                        "enum": [
                          6,
                          "ambient"
                        ]
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "auxiliary"
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
